DATABASE_URL=postgresql://duhalde:duhalde_local@127.0.0.1:5486/optica_duhalde
PORT=3186
# Con una base PostgreSQL externa, evita iniciar Docker:
# SKIP_DOCKER=true

# Se genera automáticamente en el primer npm run dev. No compartir ni versionar.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:5186

# Cliente OAuth de tipo Aplicación web (Google Cloud). Solo backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Cloud API: el remitente verificado debe ser +56953639502.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
