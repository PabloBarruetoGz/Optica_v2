{
  "name": "optica-duhalde-v2",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare.mjs && concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:migrate": "npm run migrate -w backend",
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces",
    "test": "npm test -w backend",
    "admin:create": "npm run admin:create -w backend --",
    "test:integration": "npm run test:integration -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
